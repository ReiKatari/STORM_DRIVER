<driconf>
    <device driver="turnip">
        <application name="all">
            <!-- 1. Framebuffer Compression & Stability (UBWC Guard) -->
            <option name="tu_disable_ubwc" value="true" />
            <option name="mesa_shader_cache_max_size" value="4294967296" />
            <option name="tu_subpass_fusion" value="true" />
            <option name="tu_adaptive_binning" value="true" />
            <option name="tu_fast_clears" value="true" />
            <option name="tu_async_compute" value="true" />
            <option name="tu_async_transfer" value="true" />
            <option name="tu_gcm" value="true" />
            <option name="tu_dynamic_vertex_input" value="true" />
            <option name="tu_descriptor_buffer" value="true" />
            <option name="tu_depth_bounds" value="true" />
            <option name="tu_nir_opt_loop" value="true" />
            <option name="tu_ubwc_fallback_guard" value="true" />
            <option name="tu_pipeline_library_fastpath" value="true" />
            <option name="tu_bindless_textures" value="true" />
            <option name="tu_robustness2" value="true" />
            <option name="tu_extended_dynamic_state3" value="true" />
            <option name="tu_relaxed_vertex_layout" value="true" />
            <option name="tu_shader_cache_multithreaded" value="true" />
            
            <!-- 2. Power & Frame Pacing Tuning -->
            <option name="tu_low_power_vulkan_pipeline" value="true" />
            <option name="tu_frame_time_smoothing" value="true" />
            <option name="tu_timeline_sync" value="true" />
            <option name="tu_relaxed_frame_pacing" value="true" />
            
            <!-- 3. Memory Suballocators & Monolithic Pipeline Cache -->
            <option name="tu_suballocator_pool_512k" value="true" />
            <option name="tu_pipeline_cache_lz4" value="true" />
            <option name="tu_shader_cache_size_mb" value="4096" />
        </application>
    </device>
    <device driver="freedreno">
        <application name="all">
            <option name="mesa_shader_cache_max_size" value="4294967296" />
        </application>
    </device>
    <device driver="panfrost">
        <application name="all">
            <option name="mesa_shader_cache_max_size" value="4294967296" />
            <option name="pan_early_z" value="true" />
            <option name="pan_fast_clears" value="true" />
            <option name="pan_shader_cache_multithreaded" value="true" />
        </application>
    </device>
</driconf>