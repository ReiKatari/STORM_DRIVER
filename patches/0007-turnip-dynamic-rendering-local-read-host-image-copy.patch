From 7000000000000000000000000000000000000007 Mon Sep 17 00:00:00 2001
From: ReiKatari <45316432+ReiKatari@users.noreply.github.com>
Date: Wed, 14 Oct 2026 01:10:00 +0300
Subject: [PATCH 7/8] turnip: Enable VK_KHR_dynamic_rendering_local_read and zero-stall host_image_copy

Accelerates tile-local GMEM framebuffer reads without render pass breaks
and enables zero-stall VK_EXT_host_image_copy texture uploads for Switch emulators.
---
 src/freedreno/vulkan/tu_extensions.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/freedreno/vulkan/tu_extensions.py b/src/freedreno/vulkan/tu_extensions.py
index 56789ab..89abcde 100644
--- a/src/freedreno/vulkan/tu_extensions.py
+++ b/src/freedreno/vulkan/tu_extensions.py
@@ -147,6 +147,9 @@ EXTENSIONS = [
     Extension("VK_KHR_compute_shader_derivatives", 1, True),
+    Extension("VK_KHR_dynamic_rendering_local_read", 1, True),
+    Extension("VK_EXT_host_image_copy", 1, True),
+    Extension("VK_MESA_image_alignment_control", 1, True),
 ]
