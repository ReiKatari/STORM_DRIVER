From: ReiKatari <reikatari@users.noreply.github.com>
Subject: [PATCH 0005] freedreno/vulkan: Implement adaptive GMEM tiling based on fragment shader cost

Calculates optimal GMEM binning dimensions dynamically by assessing fragment
shader instruction count, sampler pressure, and framebuffer attachment depth.
Uses the formula: tile_area = gmem_size / (per_pixel_footprint * attachment_count).

---
 src/freedreno/vulkan/tu_cmd_buffer.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.c b/src/freedreno/vulkan/tu_cmd_buffer.c
index a719c2f..e492c10 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.c
+++ b/src/freedreno/vulkan/tu_cmd_buffer.c
@@ -1045,6 +1045,30 @@ tu_tiling_config(struct tu_cmd_buffer *cmd,
    uint32_t gmem_size = cmd->device->physical_device->gmem_size;
    uint32_t per_pixel_footprint = tu_calc_attachment_footprint(pass);
    
+   /* Adaptive GMEM Tile Sizing: evaluate fragment shader ALU & sampler weight */
+   uint32_t shader_complexity_weight = 1;
+   if (cmd->state.pipeline && cmd->state.pipeline->fs) {
+      uint32_t alu_count = cmd->state.pipeline->fs->info.instrs_count;
+      uint32_t samplers = cmd->state.pipeline->fs->info.samplers_count;
+      if (alu_count > 256 || samplers > 8) {
+         shader_complexity_weight = 2;
+      }
+   }
+   
+   uint32_t dynamic_footprint = per_pixel_footprint * pass->attachment_count * shader_complexity_weight;
+   if (dynamic_footprint > 0) {
+      uint32_t optimal_tile_area = gmem_size / dynamic_footprint;
+      if (optimal_tile_area < tile_w * tile_h) {
+         tile_w = MAX2(16, tile_w / 2);
+         tile_h = MAX2(16, tile_h / 2);
+      }
+   }
+
    return (struct tu_tiling_config) {
       .tile_w = tile_w,
       .tile_h = tile_h,
-- 
